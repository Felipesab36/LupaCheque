{
  "entities": {
    "admin": {
      "title": "Admin",
      "description": "System administrator with management access",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "twoFactor": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "twoFactor"]
    },
    "visitor": {
      "title": "Visitor",
      "description": "Visitor with transient read-only access",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "validFrom": { "type": "string", "format": "date-time" },
        "validTo": { "type": "string", "format": "date-time" },
        "twoFactor": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "validFrom", "validTo", "twoFactor"]
    },
    "bankAccount": {
      "title": "Bank Account",
      "description": "Registered bank account in a specific bank",
      "type": "object",
      "properties": {
        "accountNumber": { "type": "string" },
        "bankName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "queries": { "type": "array" }
      },
      "required": ["accountNumber", "bankName", "createdAt"]
    },
    "bankAlert": {
      "title": "Bank Alert",
      "description": "Suggestion for a new bank standardization",
      "type": "object",
      "properties": {
        "suggestedBankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "userPhone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["suggestedBankName", "accountNumber", "userPhone", "createdAt"]
    },
    "systemUser": {
      "title": "System User",
      "description": "End-user of the platform",
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "activeSince": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Pagado", "Gratis", "Bloqueado"] },
        "hasFraudAlert": { "type": "boolean" }
      },
      "required": ["phone", "activeSince", "status"]
    },
    "userPayment": {
      "title": "User Payment",
      "description": "Payment record for auditing",
      "type": "object",
      "properties": {
        "userPhone": { "type": "string" },
        "paymentDate": { "type": "string", "format": "date-time" },
        "amount": { "type": "number" },
        "currentBalance": { "type": "number" },
        "status": { "type": "string", "enum": ["Correcto", "Pendiente", "Rechazado (Sin fondos)"] },
        "receiptUrl": { "type": "string" },
        "rejectReason": { "type": "string" }
      },
      "required": ["userPhone", "paymentDate", "amount", "currentBalance", "status"]
    },
    "settings": {
      "title": "Settings",
      "description": "Application wide settings (IA, Integraciones, Fiscal)",
      "type": "object",
      "properties": {
        "data": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["data", "updatedAt"]
    },
    "chatMessage": {
      "title": "Chat Message",
      "description": "Message in an AI chat conversation with a system user",
      "type": "object",
      "properties": {
        "userPhone": { "type": "string" },
        "sender": { "type": "string", "enum": ["user", "bot"] },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userPhone", "sender", "text", "timestamp"]
    }
  },
  "firestore": {
    "admins": {
      "schema": "admin",
      "description": "List of system administrators"
    },
    "visitors": {
      "schema": "visitor",
      "description": "List of temporary visitors"
    },
    "banks": {
      "schema": "bankAccount",
      "description": "Catalog of bank accounts"
    },
    "bank_alerts": {
      "schema": "bankAlert",
      "description": "Alerts for new banks to be standardized"
    },
    "users": {
      "schema": "systemUser",
      "description": "Platform users managed list"
    },
    "payments": {
      "schema": "userPayment",
      "description": "Audit list for user payments/recharges"
    },
    "settings": {
      "schema": "settings",
      "description": "Configurations for IA, Integrations and Fiscal data"
    },
    "conversations": {
      "schema": "chatMessage",
      "description": "Historic chat log messages with users"
    }
  }
}
